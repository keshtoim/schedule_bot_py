BOT_TOKEN=

# Обычный режим: страница со ссылками на файлы расписания и замен. Бот
# скачивает свежую версию при каждом обновлении, т.к. файлы каждый раз
# перезаливаются под новым именем (статическая ссылка устаревает).
COLLEGE_PAGE_URL=

# Режим разработки: путь или URL прямо к файлу-книге (например
# scratch_samples/raspisanie.xlsx), чтобы не парсить COLLEGE_PAGE_URL.
SCHEDULE_SOURCE=
ZAMENY_SOURCE=

# Сколько минут кешировать данные перед повторной загрузкой. По умолчанию 15.
CACHE_TTL_MINUTES=15

# Раз в сколько часов фоново проверять сайт на изменения в заменах
# (подписанные группы уведомляются автоматически). По умолчанию 3.
NOTIFY_INTERVAL_HOURS=3

# Куда складывать скачанные копии книг и файл «пользователь -> группа».
# По умолчанию "data".
DATA_DIR=data
