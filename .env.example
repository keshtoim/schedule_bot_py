BOT_TOKEN=

# Прокси для api.telegram.org, если сервер не видит Telegram напрямую
# (для зарубежного сервера обычно не нужен). http://host:port или
# socks5://user:pass@host:port (socks — pip install "schedule-bot[socks]").
TELEGRAM_PROXY=

# Обычный режим: страница со ссылками на файлы расписания и замен. Бот
# скачивает свежую версию при каждом обновлении, т.к. файлы каждый раз
# перезаливаются под новым именем (статическая ссылка устаревает).
COLLEGE_PAGE_URL=

# Режим разработки: путь или URL прямо к файлу-книге (например
# scratch_samples/raspisanie.xlsx), чтобы не парсить COLLEGE_PAGE_URL.
SCHEDULE_SOURCE=
ZAMENY_SOURCE=

# Сколько минут кешировать данные перед повторной загрузкой. По умолчанию 15.
CACHE_TTL_MINUTES=15

# Проверка сайта на изменения в заменах (подписанные группы уведомляются
# автоматически). Первая проверка дня — в NOTIFY_START_TIME, затем каждые
# NOTIFY_INTERVAL_HOURS часов, пока не наступит полночь; ночью не тревожим.
# По умолчанию 12:25 и раз в 3 часа -> 12:25, 15:25, 18:25, 21:25.
NOTIFY_START_TIME=12:25
NOTIFY_INTERVAL_HOURS=3

# Куда складывать скачанные копии книг, файл «пользователь -> группа» и
# состояние рассылок. По умолчанию "data" (в Docker — /data на волюме).
DATA_DIR=data

# Часовой пояс не настраивается: бот всегда считает «сегодня», чётность
# недели и время проверок по Москве, независимо от TZ сервера.

# Подробность логов в консоли: DEBUG / INFO / WARNING / ERROR. По умолчанию
# INFO (каждое действие пользователя, загрузки, проверки замен). DEBUG
# добавляет попадания в кеш и мелочи.
LOG_LEVEL=INFO
